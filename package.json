{
  "name": "kalendarz-offline",
  "productName": "Kalendarz Offline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:flatpak": "npm run build && electron-builder --linux flatpak",
    "test": "TZ=Europe/Warsaw tsx --test tests/*.test.ts",
    "test:e2e": "node tests/browser.cjs",
    "check": "npm run lint && npm test && npm run build",
    "build:android": "npm run build && cap sync android && cd android && ./gradlew assembleRelease --no-daemon",
    "test:desktop": "node tests/electron.cjs"
  },
  "build": {
    "appId": "com.vex2137.kalendarz",
    "productName": "Kalendarz Offline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "public/pwa-512x512.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "differentialPackage": false
    },
    "asar": true
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ical.js": "2.2.1",
    "rrule": "2.8.1",
    "idb": "8.0.4",
    "fflate": "0.8.2",
    "@tanstack/react-virtual": "3.14.21",
    "@capacitor/local-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.3",
  "description": "Private offline calendar with local reminders and device-to-device sync",
  "author": "vex2137",
  "desktopName": "com.vex2137.kalendarz.desktop"
}
