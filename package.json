{
  "name": "kalendarz-offline",
  "productName": "Calendar",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "build:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "build:win": "npm run build && electron-builder --win nsis portable zip --x64 --publish never",
    "build:flatpak": "bash ./build-flatpak.sh",
    "test": "TZ=Europe/Warsaw tsx --test tests/*.test.ts",
    "test:e2e": "node tests/browser.cjs",
    "check": "npm run lint && npm test && npm run build",
    "build:android": "npm run build && cap sync android && cd android && ./gradlew assembleRelease --no-daemon",
    "test:desktop": "node tests/electron.cjs",
    "test:model": "node tests/model-browser.cjs",
    "test:model:android": "node tests/model-android.cjs",
    "build:evaluation": "vite build --config tests/model-evaluation.config.ts",
    "prebuild:evaluation": "node scripts/prepare-model.cjs",
    "test:assistant:evaluation": "node tests/model-evaluation.cjs",
    "test:model:runtime": "node tests/model-runtime-browser.cjs",
    "prebuild": "node scripts/prepare-model.cjs",
    "test:native": "node --test tests/native-ai.test.cjs tests/model-folders.test.cjs tests/native-environment.test.cjs tests/model-context-native.test.cjs tests/native-startup.test.cjs tests/gpu-plan.test.cjs tests/gguf-memory.test.cjs tests/native-architectures.test.cjs",
    "test:native:model": "node --import tsx tests/native-model-smoke.cjs",
    "test:models:folders": "node tests/model-folders-electron.cjs",
    "ai:data": "node --import tsx training/generate.ts",
    "ai:data:validate": "python3 training/validate_dataset.py",
    "ai:142:data": "node --import tsx training/v142/generate.ts",
    "ai:142:validate": "python3 training/conversation_dataset.py",
    "test:upgrade:141": "node tests/upgrade-141-browser.cjs",
    "test:native:fallback": "node tests/native-process-fallback.cjs"
  },
  "build": {
    "appId": "com.vex2137.kalendarz",
    "productName": "Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "packaging/icons/png",
      "syncDesktopName": true,
      "artifactName": "Calendar-${version}-linux-${arch}.${ext}",
      "executableName": "calendar",
      "desktop": {
        "entry": {
          "Name": "Calendar",
          "StartupWMClass": "com.vex2137.kalendarz",
          "X-GNOME-UsesNotifications": "true"
        }
      }
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "packaging/icons/calendar.ico",
      "artifactName": "Calendar-${version}-windows-${arch}.${ext}",
      "signExecutable": false,
      "signAndEditExecutable": true
    },
    "nsis": {
      "differentialPackage": false,
      "artifactName": "Calendar-${version}-windows-${arch}-setup.${ext}",
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "installerIcon": "packaging/icons/calendar.ico",
      "uninstallerIcon": "packaging/icons/calendar.ico"
    },
    "asar": true,
    "portable": {
      "artifactName": "Calendar-${version}-windows-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "flatpak": {
      "runtimeVersion": "25.08",
      "baseVersion": "25.08",
      "artifactName": "Calendar-${version}-linux-${arch}.${ext}",
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--share=network",
        "--env=ELECTRON_USE_PORTAL=1"
      ]
    },
    "beforePack": "scripts/verify-packaged-model.cjs",
    "asarUnpack": [
      "dist/models/*.gguf"
    ],
    "extraResources": [
      {
        "from": "native/${os}-${arch}",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ical.js": "2.2.1",
    "rrule": "2.8.1",
    "idb": "8.0.4",
    "fflate": "0.8.2",
    "@tanstack/react-virtual": "3.14.21",
    "@capacitor/local-notifications": "^8.0.0",
    "@noble/hashes": "2.0.1",
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.3",
  "description": "Private offline calendar with local reminders and device-to-device sync",
  "author": "vex2137",
  "desktopName": "com.vex2137.kalendarz.desktop"
}
